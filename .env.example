APP_SERVICE_NAME=hot-air-balloon-api
APP_ENVIRONMENT=local
APP_DOCS_ENABLED=true
APP_LOG_LEVEL=INFO
APP_LOG_JSON=false
APP_SERVER_HOST=127.0.0.1
APP_SERVER_PORT=8000

APP_DATABASE_URL=postgresql+asyncpg://postgres:1234@localhost:5433/galaxy_universal
APP_DATABASE_ECHO=false
APP_DATABASE_POOL_SIZE=10
APP_DATABASE_MAX_OVERFLOW=20
APP_DATABASE_POOL_RECYCLE_SECONDS=1800

APP_TRUSTED_HOSTS=["localhost","127.0.0.1","testserver"]
APP_CORS_ORIGINS=[]

POSTGRES_DB=galaxy_universal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234
APP_PORT=8000

APP_SMOKE_ENABLED=true
APP_CHAT_MODEL=GPT-5.4
APP_CHAT_API_KEY=your-openai-api-key
APP_EMBEDDING_MODEL=text-embedding-3-small
APP_EMBEDDING_API_KEY=your-openai-api-key
APP_TIMEOUT_SECONDS=15
APP_CHAT_BASE_URL=your-openai-base-url

# Azure Blob
APP_AZURE_BLOB_ENABLED=true
APP_AZURE_BLOB_CONNECTION_STRING=your-azure-blob-connection-string
APP_AZURE_BLOB_CONTAINER_NAME=documents

# Upload constraints
APP_DOCUMENTS_UPLOAD_MAX_BYTES=26214400
APP_DOCUMENTS_ALLOWED_CONTENT_TYPES=["application/pdf","text/plain","text/markdown","application/vnd.openxmlformats-officedocument.wordprocessingml.document"]

# Kafka / Outbox
APP_KAFKA_ENABLED=true
APP_KAFKA_BOOTSTRAP_SERVERS=["127.0.0.1:9092"]
APP_KAFKA_DOCUMENTS_TOPIC=document.uploaded.v1
APP_KAFKA_CLIENT_ID=hot-air-balloon-api
APP_OUTBOX_PUBLISHER_ENABLED=true
APP_OUTBOX_PUBLISH_BATCH_SIZE=100
APP_OUTBOX_POLL_INTERVAL_SECONDS=1.0
APP_OUTBOX_MAX_RETRIES=10